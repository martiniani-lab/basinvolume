Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"m_", ",", "s_", ",", "c_", ",", "r_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SqrtBox[
       FractionBox["1", 
        SuperscriptBox["s", "2"]]], " ", "s"}], "+", 
     RowBox[{"Erf", "[", 
      FractionBox[
       RowBox[{"c", "+", "m", "-", "r"}], 
       RowBox[{
        SqrtBox["2"], " ", "s"}]], "]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Erf", "[", 
         FractionBox["m", 
          RowBox[{
           SqrtBox["2"], " ", "s"}]], "]"}], "-", 
        RowBox[{"Erf", "[", 
         FractionBox[
          RowBox[{"c", "+", "m", "-", "r"}], 
          RowBox[{
           SqrtBox["2"], " ", "s"}]], "]"}]}], ")"}], " ", 
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{"c", "-", "r"}], "]"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.633595293599009*^9, 3.633595353117663*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"phi_", ",", "m_", ",", "s_", ",", "c_", ",", "r_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"HeavisideTheta", "[", 
     RowBox[{"c", "-", "r"}], "]"}], "+", 
    RowBox[{"phi", "*", 
     RowBox[{"(", 
      RowBox[{"c", "/", "r"}], ")"}], "*", 
     RowBox[{"f", "[", 
      RowBox[{"m", ",", "s", ",", "c", ",", "r"}], "]"}], "*", 
