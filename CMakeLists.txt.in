# this file is meant to be parsed by python (setup.py) before being a proper CMakeLists.txt file
# in particular, the following strings will be set by python
cmake_minimum_required(VERSION 3.18)
project(basinvolume C CXX)

set(numpy_include __NUMPY_INCLUDE__)
set(PYTHON_INCLUDE_DIRS __PYTHON_INCLUDE__)
set(PYTHON_LDFLAGS "__PYTHON_LDFLAGS__")
# C/C++ sources and headers of the dependencies (pele.get_include() etc.)
set(pele_include __PELE_INCLUDE__)
set(mcpele_include __MCPELE_INCLUDE__)
set(py_cgdescent_include __PY_CGDESCENT_INCLUDE__)
# prefer sundials/eigen from pele's extern/install (source checkouts), then the environment
list(APPEND CMAKE_PREFIX_PATH __EXTRA_PREFIX_PATH__)

message("python include dirs: ${PYTHON_INCLUDE_DIRS}")
message("numpy include dirs: ${numpy_include}")
message("pele include dirs: ${pele_include}")
message("mcpele include dirs: ${mcpele_include}")
message("py_cgdescent include dirs: ${py_cgdescent_include}")
include_directories(${numpy_include})
include_directories(${PYTHON_INCLUDE_DIRS})
include_directories(${pele_include})
include_directories(${mcpele_include})
include_directories(${py_cgdescent_include})

# osx makes the suffix for shared object libraries .dylib
IF(APPLE)
  SET(CMAKE_SHARED_LIBRARY_SUFFIX ".so")
ENDIF(APPLE)

set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
SET(CMAKE_CXX_FLAGS __COMPILER_EXTRA_ARGS__)

# #################################### sundials / eigen ###############################
# (pele's sources include cvode.cpp, so basinvolume needs sundials too)
find_package(Eigen3 CONFIG QUIET)
if(TARGET Eigen3::Eigen)
  get_target_property(EIGEN3_INCLUDE_DIR Eigen3::Eigen INTERFACE_INCLUDE_DIRECTORIES)
else()
  find_path(EIGEN3_INCLUDE_DIR Eigen/Dense REQUIRED)
endif()
# lapacke.h comes with Eigen
set(LAPACKE_INCLUDE_DIR ${EIGEN3_INCLUDE_DIR}/Eigen/src/misc)

# plain find_library rather than SUNDIALS' exported targets: those can carry
# absolute paths of the toolchain sundials was built with
find_path(SUNDIALS_INCLUDE_DIR cvode/cvode.h REQUIRED)
find_library(SUNDIALS_CVODE_LIB sundials_cvode REQUIRED)
find_library(SUNDIALS_NVEC_LIB sundials_nvecserial REQUIRED)
find_library(SUNDIALS_CORE_LIB sundials_core)  # split out in sundials 7
set(SUNDIALS_LIBRARIES ${SUNDIALS_CVODE_LIB} ${SUNDIALS_NVEC_LIB})
if(SUNDIALS_CORE_LIB)
  list(APPEND SUNDIALS_LIBRARIES ${SUNDIALS_CORE_LIB})
endif()
message("SUNDIALS: ${SUNDIALS_INCLUDE_DIR} ${SUNDIALS_LIBRARIES}")
message("eigen include dir: ${EIGEN3_INCLUDE_DIR}")

# LAPACK (this also searches for BLAS automatically)
find_package(LAPACK REQUIRED)
#####################################################################################

# On Linux extensions must not link libpython (symbols resolve at import, and
# conda-forge's python is static). macOS needs the flags for libintl.
unset(CMAKE_SHARED_LINKER_FLAGS CACHE)
if(APPLE)
  set(CMAKE_SHARED_LINKER_FLAGS ${PYTHON_LDFLAGS} CACHE STRING flags)
  # PYTHON_LDFLAGS attempts to link against the gettext libintl library
  find_package(Intl REQUIRED)
  include_directories(${Intl_INCLUDE_DIRS})
  get_filename_component(Intl_LIBRARY_DIR ${Intl_LIBRARIES} DIRECTORY)
endif(APPLE)

# set the basinvolume include directory
set(bv_include ${CMAKE_SOURCE_DIR}/source)
include_directories(BEFORE SYSTEM ${bv_include})
include_directories(BEFORE SYSTEM ${EIGEN3_INCLUDE_DIR})
include_directories(BEFORE SYSTEM ${SUNDIALS_INCLUDE_DIR})
include_directories(BEFORE SYSTEM ${LAPACKE_INCLUDE_DIR})
message("basinvolume include directory: ${bv_include}")

# build the bv library, static so the installed extensions don't depend on a
# libbv_lib.so in the build dir
FILE(GLOB pele_sources ${pele_include}/*.c*)
FILE(GLOB mcpele_sources ${mcpele_include}/*.c*)
FILE(GLOB py_cgdescent_sources ${py_cgdescent_include}/CG_DESCENT/*.c)
FILE(GLOB bv_sources ${bv_include}/*.cpp)
add_library(bv_lib STATIC ${bv_sources} ${py_cgdescent_sources} ${mcpele_sources} ${pele_sources})
set_target_properties(bv_lib PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_link_libraries(bv_lib PUBLIC ${SUNDIALS_LIBRARIES} ${LAPACK_LIBRARIES})

# Apple-specific linking
if(APPLE)
  target_link_directories(bv_lib PUBLIC ${Intl_LIBRARY_DIR})
endif(APPLE)

# Apple changed the ld linker in Xcode 15 which breaks pele.
# The classic linker can be chosen with -ld_classic flag.
# However, on older Xcode versions, this flag throws an error.
# Thus, we simply check here whether this flag exists.
# See https://www.scivision.dev/xcode-ld_classic/
# For the undefined flag, see
# https://github.com/nasa/cFE/issues/476#issuecomment-579436106
if(APPLE)
  include(CheckLinkerFlag)
  check_linker_flag(C "-ld_classic" CLASSIC_FLAG)
  if(CLASSIC_FLAG)
    set(APPLE_LINK_OPTIONS "LINKER:-undefined,dynamic_lookup,-ld_classic")
  else(CLASSIC_FLAG)
    set(APPLE_LINK_OPTIONS "LINKER:-undefined,dynamic_lookup")
  endif(CLASSIC_FLAG)
endif(APPLE)

function(make_cython_lib cython_cxx_source)
  get_filename_component(library_name ${cython_cxx_source} NAME)
  string(REGEX REPLACE "\\.c(xx)?$" "" library_name ${library_name})
  add_library(${library_name} SHARED ${cython_cxx_source})

  if(APPLE)
    target_link_options(${library_name} PUBLIC ${APPLE_LINK_OPTIONS})
  elseif(UNIX)
    # Python symbols are resolved at runtime when the module is imported.
    target_link_options(${library_name} PUBLIC "LINKER:--unresolved-symbols=ignore-all")
  endif()

  target_link_libraries(${library_name} PUBLIC bv_lib)
  set_target_properties(${library_name} PROPERTIES PREFIX "")
  set_target_properties(${library_name} PROPERTIES SUFFIX ".so")
  message("making library ${library_name} from source ${cython_cxx_source}")
endfunction(make_cython_lib)
